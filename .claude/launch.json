{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "todo-viewer",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "src_old/backend/main.py"
      ],
      "port": 5411,
      "autoPort": true
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "src_old/web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
