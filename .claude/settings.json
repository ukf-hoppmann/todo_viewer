{
  "enabledPlugins": {
    "claude-harness@claude-harness-dev": true
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_architecture.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_backlog_dirty.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_techdocs.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_doclinks.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_public_api.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_architecture_read.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_active_item.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/mark_notes_state.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/remind_notes.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_backlog.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_notes_state.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_daily.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_techdocs.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_doclinks.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_public_api.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude-harness/runtime/scripts/check_semver.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
